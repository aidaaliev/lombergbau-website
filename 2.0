<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lomberg Bau Berlin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background: #f5f5f5;
      color: #111;
      line-height: 1.6;
    }

    header {
      background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)),
      url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2070&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 40px;
      color: white;
    }

    .hero {
      max-width: 700px;
    }

    .logo {
      width: 300px;
      margin-bottom: 40px;
    }

    h1 {
      font-size: 72px;
      line-height: 1.1;
      margin-bottom: 25px;
      font-weight: 700;
    }

    .highlight {
      color: #149bb4;
    }

    .hero p {
      font-size: 22px;
      margin-bottom: 35px;
      color: rgba(255,255,255,0.9);
    }

    .btn {
      display: inline-block;
      background: #149bb4;
      color: white;
      padding: 16px 32px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      transition: 0.3s ease;
    }

    .btn:hover {
      background: #0d768a;
    }

    section {
      padding: 100px 10%;
    }

    .section-title {
      font-size: 48px;
      margin-bottom: 60px;
      text-align: center;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 30px;
    }

    .card {
      background: white;
      padding: 35px;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      transition: 0.3s ease;
    }

    .card:hover {
      transform: translateY(-6px);
    }

    .card h3 {
      margin-bottom: 15px;
      color: #149bb4;
      font-size: 24px;
    }

    .stats {
      background: #111;
      color: white;
      display: flex;
      justify-content: center;
      gap: 80px;
      flex-wrap: wrap;
      text-align: center;
    }

    .stat h2 {
      font-size: 60px;
      color: #149bb4;
    }

    .contact {
      background: white;
      border-radius: 20px;
      padding: 60px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      max-width: 900px;
      margin: auto;
    }

    footer {
      background: #111;
      color: white;
      padding: 40px;
      text-align: center;
    }

    .legal {
      margin-top: 20px;
      font-size: 14px;
      color: rgba(255,255,255,0.7);
    }

    @media(max-width: 768px) {
      h1 {
        font-size: 48px;
      }

      .hero p {
        font-size: 18px;
      }

      section {
        padding: 70px 8%;
      }

      .contact {
        padding: 40px;
      }
    }
  </style>
</head>
<body>

<header>
  <div class="hero">

    <img src="logo.png" alt="Lomberg Bau Logo" class="logo">

    <h1>
      Bauen mit <span class="highlight">Präzision</span><br>
      & Leidenschaft
    </h1>

    <p>
      Ihr zuverlässiger Partner für hochwertige Bau-, Sanierungs-
      und Dienstleistungsarbeiten in Berlin.
    </p>

    <a href="#leistungen" class="btn">Unsere Leistungen</a>
  </div>
</header>

<section id="leistungen">
  <h2 class="section-title">Unsere Leistungen</h2>

  <div class="services">

    <div class="card">
      <h3>Spachtelarbeiten</h3>
      <p>Saubere und präzise Oberflächenarbeiten für Neubau und Sanierung.</p>
    </div>

    <div class="card">
      <h3>Abrissarbeiten</h3>
      <p>Professionelle Rückbau- und Abrissarbeiten mit effizienter Umsetzung.</p>
    </div>

    <div class="card">
      <h3>Trockenbau</h3>
      <p>Flexible und moderne Innenausbaulösungen für Wohn- und Gewerbeobjekte.</p>
    </div>

    <div class="card">
      <h3>Gebäudereinigung</h3>
      <p>Zuverlässige Reinigungslösungen für private und gewerbliche Immobilien.</p>
    </div>

    <div class="card">
      <h3>Winterdienst</h3>
      <p>Sicherer und professioneller Winterdienst für Grundstücke und Gewerbeflächen.</p>
    </div>

  </div>
</section>

<section class="stats">

  <div class="stat">
    <h2>10+</h2>
    <p>Jahre Erfahrung</p>
  </div>

  <div class="stat">
    <h2>30+</h2>
    <p>Erfolgreiche Projekte</p>
  </div>

</section>

<section>
  <div class="contact">

    <h2 class="section-title">Kontakt</h2>

    <p><strong>Lomberg Bau Berlin UG (haftungsbeschränkt)</strong></p>
    <p>Prenzlauer Allee 7</p>
    <p>10405 Berlin</p>

    <br>

    <p><strong>Geschäftsführer:</strong> Azamat Iusupov</p>
    <p><strong>Telefon:</strong> +49 176 76792294</p>
    <p><strong>E-Mail:</strong> info@lombergbau.de</p>

  </div>
</section>

<footer>
  <p>© 2026 Lomberg Bau Berlin UG (haftungsbeschränkt)</p>

  <div class="legal">
    Handelsregister: HRB 254438 B · Amtsgericht Charlottenburg
  </div>
</footer>

</body>
</html>
